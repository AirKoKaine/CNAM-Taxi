      <label class="inline"><input id="isTPMR" type="checkbox"> Véhicule TPMR équipé (+30 €)</label>
      <label for="tolls">Péages payés sur le trajet (€, sur justificatif) :</label>
      <input id="tolls" type="number" min="0" step="0.01" value="0">
    </fieldset>

