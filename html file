    <!-- ===== Forfait Grande ville ===== -->
    <fieldset>
      <legend>Forfait « Grande ville » (+15 €)</legend>
      <p class="hint" style="margin-bottom:6px">Dû si le patient est pris en charge <strong>et/ou</strong> déposé à Marseille, Paris, Nice, Toulouse, Lyon, Strasbourg, Montpellier, Rennes, Bordeaux, Lille, Grenoble, Nantes, dans une commune du 92, 93 ou 94, ou dans un établissement frontalier validé par la Cnam.</p>
      <div class="row">
        <div class="col">
          <label for="placeFrom">Lieu de prise en charge :</label>
          <input id="placeFrom" type="text" list="gvPlaces" placeholder="Commune ou établissement" autocomplete="off">
        </div>
        <div class="col">
          <label for="placeTo">Lieu de dépose :</label>
          <input id="placeTo" type="text" list="gvPlaces" placeholder="Commune ou établissement" autocomplete="off">
        </div>
      </div>
      <datalist id="gvPlaces"></datalist>
      <span id="gvBadge" class="badge off">Forfait Grande ville non applicable</span>
      <label class="inline"><input id="isGrandeVille" type="checkbox"> Appliquer le forfait Grande ville</label>
      <p class="hint">La case se coche toute seule quand un lieu reconnu est saisi. Vous pouvez la cocher ou la décocher à la main.</p>
    </fieldset>

